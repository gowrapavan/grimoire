{
  "name": "biblorya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:worker",
    "preview": "vite preview",
    "build:catalog": "node scripts/build-catalog.mjs",
    "test": "vitest run",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/_worker.js && esbuild worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/seo-worker.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
